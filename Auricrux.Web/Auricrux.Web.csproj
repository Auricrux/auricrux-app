<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <InformationalVersion>1.4.0</InformationalVersion>
    <AuricruxPackageVersion>1.4.0</AuricruxPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Bootstrap" Version="5.3.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Auricrux.Shared\Auricrux.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\construction-corpus.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\auricrux\system\model_manifest.json" Link="auricrux\system\model_manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\auricrux\system\package_stamp.json" Link="auricrux\system\package_stamp.json" Condition="Exists('..\auricrux\system\package_stamp.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Stamp runs on Windows local builds; CI Linux uses pwsh if available; failure is non-fatal -->
  <Target Name="WriteAuricruxPackageStamp" BeforeTargets="BeforeBuild;BeforePublish"
          Condition="Exists('$(MSBuildThisFileDirectory)..\scripts\Write-AuricruxPackageStamp.ps1')">
    <PropertyGroup>
      <_PsExe Condition="'$(OS)' == 'Windows_NT'">powershell -NoProfile -ExecutionPolicy Bypass</_PsExe>
      <_PsExe Condition="'$(OS)' != 'Windows_NT'">pwsh -NoProfile</_PsExe>
    </PropertyGroup>
    <Exec Command="$(_PsExe) -File &quot;$(MSBuildThisFileDirectory)..\scripts\Write-AuricruxPackageStamp.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)..&quot; -PackageVersion &quot;$(AuricruxPackageVersion)&quot;"
          IgnoreExitCode="true"
          ContinueOnError="true" />
  </Target>

</Project>
