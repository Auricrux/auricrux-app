@page "/intelligence"
@using Auricrux.Web.Services
@inject IntelligenceDashboardService DashboardService
@inject ILogger<Dashboard> Logger
@rendermode InteractiveServer

<PageTitle>Intelligence Dashboard - Auricrux</PageTitle>

<div class="intelligence-dashboard p-6 bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
                <span class="text-4xl">🔮</span>
                Intelligence Dashboard
            </h1>
            <p class="text-gray-600 mt-2">Real-time observability into Auricrux's learning loop and predictive intelligence</p>
        </div>

        @if (loading)
        {
            <div class="flex items-center justify-center h-64">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
                    <p class="text-gray-600">Loading intelligence metrics...</p>
                </div>
            </div>
        }
        else if (error != null)
        {
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                <h3 class="text-red-800 font-semibold mb-2">⚠️ Error Loading Dashboard</h3>
                <p class="text-red-700">@error</p>
            </div>
        }
        else
        {
            @if (overview.Status == "in_memory_breakthrough")
            {
                <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
                    <h3 class="text-amber-900 font-semibold mb-1">Running without Atlas persistence</h3>
                    <p class="text-amber-800">@overview.StatusMessage</p>
                </div>
            }

            <!-- Executive Overview Metrics -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                <MetricCard 
                    Title="Events Captured" 
                    Value="@overview.EventsCaptured.ToString()" 
                    Subtitle="@overview.Period"
                    Icon="📊"
                    Color="blue" />
                
                <MetricCard 
                    Title="Outcomes Verified" 
                    Value="@overview.OutcomesVerified.ToString()" 
                    Subtitle="@($"{overview.OutcomesRecorded} total recorded")"
                    Icon="✅"
                    Color="green" />
                
                <MetricCard 
                    Title="Predictive Transfers" 
                    Value="@overview.PredictiveTransfers.ToString()" 
                    Subtitle="Cross-project alerts"
                    Icon="🔮"
                    Color="purple" />
                
                <MetricCard 
                    Title="Issues Prevented" 
                    Value="@overview.IssuesPrevented.ToString()" 
                    Subtitle="@($"~${overview.EstimatedSavingsUsd:N0} saved")"
                    Icon="🛡️"
                    Color="green" />
            </div>

            <!-- Learning Loop & Predictive Transfers Row -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                <!-- Learning Loop Visualization -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
                        <span>🔄</span>
                        Learning Loop Pipeline
                    </h2>
                    
                    @if (learningLoop != null && learningLoop.Stages.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var stage in learningLoop.Stages)
                            {
                                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                                    <div class="flex-1">
                                        <div class="font-medium text-gray-900">@stage.Name</div>
                                        <div class="text-sm text-gray-600">
                                            @stage.Count24h in 24h • @stage.Count7d in 7d
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-2xl font-bold text-blue-600">@stage.Count24h</div>
                                        <div class="text-xs text-gray-500">@($"{stage.AvgPerHour:F1}/hr")</div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        @if (!string.IsNullOrEmpty(learningLoop.BottleneckStage))
                        {
                            <div class="mt-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                                <p class="text-sm text-yellow-800">
                                    ⚠️ Potential bottleneck detected: <strong>@learningLoop.BottleneckStage</strong>
                                </p>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-gray-500 text-center py-8">No learning loop data available</p>
                    }
                </div>

                <!-- Recent Predictive Transfers -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
                        <span>⚡</span>
                        Recent Predictive Transfers
                    </h2>
                    
                    @if (transfers.Any())
                    {
                        <div class="space-y-3 max-h-96 overflow-y-auto">
                            @foreach (var transfer in transfers.Take(8))
                            {
                                <div class="p-3 bg-purple-50 border border-purple-200 rounded-lg hover:bg-purple-100 transition-colors">
                                    <div class="flex items-start justify-between mb-2">
                                        <div class="font-medium text-purple-900">
                                            → @transfer.TargetProject
                                        </div>
                                        <div class="text-xs text-purple-700 font-mono">
                                            @($"{transfer.SimilarityScore:P0}")
                                        </div>
                                    </div>
                                    <div class="text-sm text-purple-700 mb-1">
                                        From: @transfer.SourceProject
                                    </div>
                                    <div class="text-xs text-purple-600">
                                        Predicted: @transfer.PredictedTimeframe
                                    </div>
                                    @if (transfer.MatchedFactors.Any())
                                    {
                                        <div class="flex flex-wrap gap-1 mt-2">
                                            @foreach (var factor in transfer.MatchedFactors.Take(3))
                                            {
                                                <span class="px-2 py-1 bg-purple-200 text-purple-800 rounded text-xs">
                                                    @factor.Replace("_", " ")
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-500 text-center py-8">No predictive transfers yet</p>
                    }
                </div>
            </div>

            <!-- Knowledge Gaps & Audit Trail Row -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                <!-- Active Knowledge Gaps -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
                        <span>🎯</span>
                        Active Knowledge Gaps
                    </h2>
                    
                    @if (knowledgeGaps.Any())
                    {
                        <div class="space-y-2 max-h-96 overflow-y-auto">
                            @foreach (var gap in knowledgeGaps.Take(10))
                            {
                                var severityColor = gap.Severity switch
                                {
                                    "high" => "red",
                                    "medium" => "yellow",
                                    _ => "gray"
                                };
                                
                                <div class="p-3 bg-gray-50 border border-gray-200 rounded-lg hover:bg-gray-100 transition-colors">
                                    <div class="flex items-start justify-between mb-1">
                                        <div class="font-medium text-gray-900 flex-1">
                                            @gap.Pattern
                                        </div>
                                        <span class="px-2 py-1 bg-@(severityColor)-100 text-@(severityColor)-800 rounded text-xs font-semibold ml-2">
                                            @gap.Frequency
                                        </span>
                                    </div>
                                    <div class="text-sm text-gray-600 flex items-center gap-3">
                                        <span>@gap.RecommendationsCount recs</span>
                                        @if (gap.AcademyLinkStatus == "linked")
                                        {
                                            <span class="text-green-600">📚 Academy linked</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-500 text-center py-8">No knowledge gaps identified</p>
                    }
                </div>

                <!-- Recent Audit Trail -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
                        <span>📋</span>
                        Recent Activity
                    </h2>
                    
                    @if (auditActions.Any())
                    {
                        <div class="space-y-2 max-h-96 overflow-y-auto">
                            @foreach (var action in auditActions.Take(12))
                            {
                                var resultColor = action.Result == "success" ? "green" : "red";
                                var icon = action.ActionType switch
                                {
                                    "predictive_transfer" => "🔮",
                                    "outcome_verified" => "✅",
                                    "recommendation_generated" => "💡",
                                    "gap_identified" => "🎯",
                                    _ => "📌"
                                };
                                
                                <div class="flex items-start gap-2 p-2 hover:bg-gray-50 rounded transition-colors">
                                    <span class="text-lg">@icon</span>
                                    <div class="flex-1 min-w-0">
                                        <div class="text-sm text-gray-900">@action.Description</div>
                                        <div class="text-xs text-gray-500">
                                            @action.Timestamp.ToString("HH:mm:ss") • @action.Actor
                                        </div>
                                    </div>
                                    <span class="text-@(resultColor)-600 text-xs font-semibold flex-shrink-0">
                                        @action.Result
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-500 text-center py-8">No recent activity</p>
                    }
                </div>
            </div>

            <!-- System Health Footer -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
                    <span>💚</span>
                    System Health
                </h2>
                
                <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
                    <HealthIndicator Service="MongoDB Atlas" Status="@overview.Health.AtlasStatus" />
                    <HealthIndicator Service="FCA API" Status="@overview.Health.FcaApiStatus" />
                    <HealthIndicator Service="Ollama" Status="@overview.Health.OllamaStatus" />
                    <HealthIndicator Service="Learning Worker" Status="@overview.Health.WorkerStatus" />
                    <HealthIndicator Service="Predictive Orchestrator" Status="@overview.Health.OrchestratorStatus" />
                </div>
            </div>

            <!-- Last Updated -->
            <div class="mt-6 text-center text-sm text-gray-500">
                Last updated: @DateTime.Now.ToString("HH:mm:ss") • 
                <button @onclick="RefreshData" class="text-blue-600 hover:text-blue-800 font-medium">
                    Refresh Now
                </button>
            </div>
        }
    </div>
</div>

@code {
    private DashboardOverview overview = new();
    private LearningLoopMetrics learningLoop = new();
    private List<PredictiveTransferSummary> transfers = new();
    private List<KnowledgeGapSummary> knowledgeGaps = new();
    private List<AuditAction> auditActions = new();
    private bool loading = true;
    private string? error = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
        
        // Auto-refresh every 30 seconds
        _ = Task.Run(async () =>
        {
            while (true)
            {
                await Task.Delay(30000);
                await InvokeAsync(async () =>
                {
                    await LoadDashboardData();
                    StateHasChanged();
                });
            }
        });
    }

    private async Task LoadDashboardData()
    {
        try
        {
            loading = true;
            error = null;

            // Load all dashboard data in parallel
            var overviewTask = DashboardService.GetOverviewAsync(TimeSpan.FromHours(24));
            var loopTask = DashboardService.GetLearningLoopMetricsAsync();
            var transfersTask = DashboardService.GetRecentTransfersAsync(20);
            var gapsTask = DashboardService.GetActiveKnowledgeGapsAsync();
            var auditTask = DashboardService.GetRecentAuditActionsAsync(50);

            await Task.WhenAll(overviewTask, loopTask, transfersTask, gapsTask, auditTask);

            overview = await overviewTask;
            learningLoop = await loopTask;
            transfers = await transfersTask;
            knowledgeGaps = await gapsTask;
            auditActions = await auditTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading dashboard data");
            error = $"Failed to load dashboard: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadDashboardData();
    }
}
