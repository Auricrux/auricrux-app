@{
    var (statusIcon, statusColor, statusText) = Status.ToLowerInvariant() switch
    {
        "healthy" or "operational" or "active" or "ollama-live" => ("✅", "green", Status is "ollama-live" ? "Ollama live" : "Healthy"),
        "configured" or "hosted" or "self" => ("ℹ️", "blue", Status),
        "unavailable" or "error" or "unreachable" => ("❌", "red", "Unavailable"),
        "degraded" or "warning" or "ollama-degraded" or "corpus-fallback" => ("⚠️", "yellow", Status),
        "not_configured" or "unobserved" => ("⚪", "gray", Status.Replace('_', ' ')),
        _ => ("⚪", "gray", string.IsNullOrWhiteSpace(Status) ? "Unknown" : Status)
    };
}

<div class="flex items-center gap-2 p-3 bg-gray-50 rounded-lg">
    <div class="text-2xl">@statusIcon</div>
    <div class="flex-1 min-w-0">
        <div class="text-sm font-medium text-gray-900">@Service</div>
        <div class="text-xs text-@(statusColor)-600 font-semibold">@statusText</div>
    </div>
</div>

@code {
    [Parameter] public string Service { get; set; } = "";
    [Parameter] public string Status { get; set; } = "unknown";
}
